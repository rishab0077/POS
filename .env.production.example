APP_NAME="Restaurant POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.example.com
TIME_ZONE=Asia/Kathmandu

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Keep 127.0.0.1 behind a reverse proxy. Use 0.0.0.0 only on a trusted LAN.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8097
APP_HEALTH_HOST=pos.example.com
SOKETI_PORT=6001
APP_IMAGE_REPOSITORY=restaurant-pos-app
WEB_IMAGE_REPOSITORY=restaurant-pos-web
APP_IMAGE_TAG=latest

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=restaurant_pos
DB_USERNAME=restaurant_pos
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CBMS_ENABLED=false
CBMS_ACCEPTANCE_MODE=false
CBMS_URL=https://cbapi.ird.gov.np
CBMS_USERNAME=
CBMS_PASSWORD=
CBMS_TIMEOUT=15
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
CORS_ALLOWED_ORIGINS=

# Set HOST_SEPARATION_ENFORCED=true only after public/private DNS is ready.
HOST_SEPARATION_ENFORCED=false
PUBLIC_APP_HOSTS=pos.example.com
PRIVATE_APP_HOSTS=pos.example.com
PRINT_SERVICE_HOSTS=pos.example.com

# Set the café static IP and an emergency VPN CIDR before enabling.
PRIVATE_IP_RESTRICTION_ENABLED=false
PRIVATE_ALLOWED_IPS=
PRIVATE_EMERGENCY_IPS=

# Public /health is kept enabled for deployment compatibility. Prefer host
# Nginx allowlisting before switching this to false.
HEALTH_PUBLIC_ENABLED=true
HEALTH_ALLOWED_IPS=127.0.0.1,::1

SECURITY_HEADERS_ENABLED=true
SECURITY_HEADER_X_FRAME_OPTIONS=SAMEORIGIN
SECURITY_HEADER_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HEADER_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_REPORT_ONLY_ENABLED=true

RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_PRINT_STATION_PER_MINUTE=120
RATE_LIMIT_BROADCAST_AUTH_PER_MINUTE=60
RATE_LIMIT_AUDIT_EXPORT_PER_MINUTE=6

MFA_ISSUER="Restaurant POS"
MFA_ENABLED=true
STEP_UP_TIMEOUT=600

# Enable after the print agent has matching service credentials.
PRINT_SERVICE_AUTH_REQUIRED=false
PRINT_SERVICE_CLIENT_ID=
PRINT_SERVICE_CLIENT_SECRET=

AUDIT_LOGGING_ENABLED=true
AUDIT_LOGGING_FAIL_CLOSED=false

PUSHER_APP_ID=restaurant-pos
PUSHER_APP_KEY=restaurant-pos-key
PUSHER_APP_SECRET=CHANGE_ME_SOKETI_SECRET
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
PUSHER_APP_ENCRYPTED=false

VAT_RATE=13
VAT_INCLUSIVE=true
SERVICE_CHARGE_ENABLED=false
SERVICE_CHARGE_RATE=0

BUSINESS_NAME="Restaurant POS"
BUSINESS_ADDRESS="Kathmandu, Nepal - TO BE UPDATED"
BUSINESS_PAN="TO BE UPDATED"
BUSINESS_VAT="TO BE UPDATED"
INVOICE_FORMAT=thermal_80mm
FISCAL_YEAR_BILL_PREFIX_AUTO=true
RECEIPT_CUSTOMER_COPY_ENABLED=true
RECEIPT_RESTAURANT_COPY_ENABLED=false
RECEIPT_DEFAULT_COPIES=customer
RECEIPT_FOOTER_TEXT=
RECEIPT_WIDTH=80mm

BACKUP_ENABLED=true
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_STORAGE_PATH=/var/www/html/storage/backups
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_PATH=/mnt/restaurant-pos-backups
MONITORING_ALERT_EMAIL=
MONITORING_FAILED_JOB_THRESHOLD=1
MONITORING_DISK_WARNING_PERCENT=80
MONITORING_DISK_CRITICAL_PERCENT=90
MONITORING_PRINT_STATION_OFFLINE_MINUTES=5
MONITORING_SCHEDULER_MAX_AGE_MINUTES=3
MONITORING_CLOCK_MAX_SKEW_SECONDS=5
MONITORING_CBMS_PENDING_MAX_MINUTES=15
MONITORING_BACKUP_MAX_AGE_HOURS=30
MONITORING_ALERT_COOLDOWN_MINUTES=60

ADMIN_NAME="Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

LINK_TARGET=_blank
