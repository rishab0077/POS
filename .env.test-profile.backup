APP_NAME="Restaurant POS"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8097
TIME_ZONE=Asia/Kathmandu

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_HTTP_PORT=8097
APP_HEALTH_HOST=127.0.0.1
SOKETI_PORT=6001

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=restaurant_pos_test
DB_USERNAME=restaurant_pos_test
DB_PASSWORD=restaurant_pos_test_password
MYSQL_ROOT_PASSWORD=restaurant_pos_test_root_password

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

PUSHER_APP_ID=restaurant-pos
PUSHER_APP_KEY=restaurant-pos-key
PUSHER_APP_SECRET=restaurant_pos_test_soketi_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
PUSHER_APP_ENCRYPTED=false
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

VAT_RATE=13
VAT_INCLUSIVE=true
SERVICE_CHARGE_ENABLED=false
SERVICE_CHARGE_RATE=0

BUSINESS_NAME="Restaurant POS"
BUSINESS_ADDRESS="Kathmandu, Nepal"
BUSINESS_PAN="123456789"
BUSINESS_VAT="123456789"
INVOICE_FORMAT=thermal_80mm
FISCAL_YEAR_BILL_PREFIX_AUTO=true

ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="RestaurantPosTest123!"

LINK_TARGET=_blank
